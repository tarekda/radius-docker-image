sql {
    dialect = "mysql"
    
    # Make dialect accessible to other modules
    modules {
        sql {
            dialect = "mysql"
        }
    }

    driver = "rlm_sql_mysql"
    # Use container environment variables (set via docker-compose.yml)
    server = "$ENV{SQL_SERVER}"
    port = "$ENV{SQL_PORT}"
    login = "$ENV{SQL_USER}"
    password = "$ENV{SQL_PASSWORD}"
    radius_db = "$ENV{SQL_DATABASE}"
    read_clients = yes 
    client_table = nas
    # The authorize/accounting policies use several SQL xlats per packet.
    # Keep this above normal auth/accounting burst concurrency or requests will queue
    # in rlm_sql and NAS retransmits show up as "duplicate packet ... unfinished request".
    # Make sure MySQL max_connections is comfortably higher than this value.
    max_connections = 25
    remove_stale_sessions = yes
    read_groups = no
    read_profiles = yes


    # Username columns should share the same collation so MySQL can use indexes.
    # Avoid forcing COLLATE in these hot authorize queries.
    authorize_check_query = "SELECT rc.id, rc.username, rc.attribute, rc.value, rc.op \
       FROM radcheck rc \
       JOIN raduserprofile rup ON rc.username = rup.username \
       WHERE rc.username = '%{User-Name}' \
       AND (rup.account_status = 'active' OR rup.account_status = 'suspended')"

    # Return Mikrotik-Rate-Limit based on the user's profile.
    # If the user is in fallback (or over quota), return the "Fallback" profile speed.
    authorize_reply_query = "SELECT up.id, \
                            up.username, 'Mikrotik-Rate-Limit' AS attribute, \
                            CONCAT( \
                              (CASE \
                                WHEN ( \
                                  up.is_fallback = 1 OR up.is_monthly_exceeded = 1 OR \
                                  (SELECT COALESCE(SUM(r1.data_usage), 0) FROM radusagestats r1 WHERE r1.username = up.username AND r1.day = CURDATE()) > p.daily_quota OR \
                                  (SELECT COALESCE(SUM(r2.data_usage), 0) FROM radusagestats r2 \
                                     WHERE r2.username = up.username \
                                       AND r2.day >= ( \
                                         SELECT CASE \
                                           WHEN DAY(NOW()) >= up2.quota_reset_day \
                                             THEN DATE(CONCAT(YEAR(NOW()), '-', LPAD(MONTH(NOW()), 2, '0'), '-', LPAD(up2.quota_reset_day, 2, '0'))) \
                                           ELSE DATE(CONCAT(YEAR(DATE_SUB(NOW(), INTERVAL 1 MONTH)), '-', LPAD(MONTH(DATE_SUB(NOW(), INTERVAL 1 MONTH)), 2, '0'), '-', LPAD(up2.quota_reset_day, 2, '0'))) \
                                         END \
                                         FROM raduserprofile up2 WHERE up2.username = up.username \
                                       ) \
                                   ) > p.monthly_quota \
                                ) \
                                THEN COALESCE(fb.speed_down, p.speed_down) \
                                ELSE p.speed_down \
                              END), \
                              'k/', \
                              (CASE \
                                WHEN ( \
                                  up.is_fallback = 1 OR up.is_monthly_exceeded = 1 OR \
                                  (SELECT COALESCE(SUM(r1.data_usage), 0) FROM radusagestats r1 WHERE r1.username = up.username AND r1.day = CURDATE()) > p.daily_quota OR \
                                  (SELECT COALESCE(SUM(r2.data_usage), 0) FROM radusagestats r2 \
                                     WHERE r2.username = up.username \
                                       AND r2.day >= ( \
                                         SELECT CASE \
                                           WHEN DAY(NOW()) >= up2.quota_reset_day \
                                             THEN DATE(CONCAT(YEAR(NOW()), '-', LPAD(MONTH(NOW()), 2, '0'), '-', LPAD(up2.quota_reset_day, 2, '0'))) \
                                           ELSE DATE(CONCAT(YEAR(DATE_SUB(NOW(), INTERVAL 1 MONTH)), '-', LPAD(MONTH(DATE_SUB(NOW(), INTERVAL 1 MONTH)), 2, '0'), '-', LPAD(up2.quota_reset_day, 2, '0'))) \
                                         END \
                                         FROM raduserprofile up2 WHERE up2.username = up.username \
                                       ) \
                                   ) > p.monthly_quota \
                                ) \
                                THEN COALESCE(fb.speed_up, p.speed_up) \
                                ELSE p.speed_up \
                              END), \
                              'k' \
                            ) AS value, ':=' AS op \
                            FROM raduserprofile up \
                            JOIN radprofile p ON p.id = up.profile_id \
                            LEFT JOIN radprofile fb ON fb.profile_name = 'Fallback' \
                            WHERE up.username = '%{User-Name}'"

    #client_query = "SELECT nasname as ipaddr, secret FROM nas WHERE nasname = '%{Packet-Src-IP-Address}'"
    #client_query = "SELECT nasname, secret FROM nas WHERE nasname = '%{Packet-Src-IP-Address}' LIMIT 1"

    # SQL query logging (VERY noisy). Enable only when debugging.
    # logfile = ${logdir}/sqllog.sql

    #
    # Load the SQL queries for this dialect (authorize/accounting/post-auth/etc).
    # Without this, accounting records (radacct) will NOT be written.
    #
    $INCLUDE ${modconfdir}/sql/main/${dialect}/queries.conf
}