server default {
    listen {
        type = auth
        ipaddr = 0.0.0.0
        port = 1812
        limit {
              max_connections = 16
              lifetime = 0
              idle_timeout = 30
        }
    }

    listen {
        type = acct
        ipaddr = 0.0.0.0
        port = 1813
    }

    listen {
        type = coa
        ipaddr = 0.0.0.0
        port = 1700
    }

    authorize {
  
        filter_username
        preprocess
        chap
        mschap
        sql
        pap

        # Request logging (for Grafana/Loki). Enable with RADIUS_REQUEST_LOG_ENABLED=1
        # NOTE: use $ENV{...} (config-time substitution). %{env:...} is not available as a core xlat here.
        if ("$ENV{RADIUS_REQUEST_LOG_ENABLED}" == "1") {
            radius_request_log
        }

        "%{sql:insert into connection_logs (username, mac_address, nas_ip, status, reply_message, timestamp) values ('%{User-Name}', '%{Calling-Station-Id}', '%{NAS-IP-Address}', 'attempt', NULL, NOW());}"
        
        
        # Check if user is active
        if ("%{sql:SELECT CASE WHEN account_status = 'active' THEN 1 ELSE 0 END FROM raduserprofile WHERE username = '%{User-Name}'}" == 0) {
            update reply {
                Reply-Message := "Account is not active"
            }
            reject
        }

        # Sanitize MAC address
        mac-format

        # Check if user has any MAC bindings
        if ("%{sql:SELECT COUNT(*) FROM user_mac WHERE username = '%{User-Name}'}" > 0) {
            # Check if the Calling-Station-Id (MAC) matches the bound MAC
            if ("%{sql:SELECT COUNT(*) FROM user_mac WHERE username = '%{User-Name}' AND mac_address = '%{Calling-Station-Id}'}" == 0) {
                update reply {
                    Reply-Message := "Unauthorized MAC address. Access Denied."
                }
                reject
            }
        }

        # Rate limiting (protect against brute-force / buggy retry loops).
        # NOTE: keep this threshold high enough to avoid blocking legitimate users when the NAS retries quickly.
        if ("%{sql:SELECT COUNT(*) FROM connection_logs WHERE mac_address = '%{Calling-Station-Id}' AND status = 'rejected' AND timestamp > DATE_SUB(NOW(), INTERVAL 5 MINUTE)}" > 50) {
            update request {
                Tmp-Integer-7 := 1
            }
            update reply {
                Reply-Message := "Rate limited: too many failed attempts"
            }
            reject
        }

        # Block known malicious MACs
        if ("%{sql:SELECT COUNT(*) FROM blocked_macs WHERE mac_address = '%{Calling-Station-Id}'}" > 0) {
            update reply {
                Reply-Message := "Blocked MAC address"
            }
            reject
        }

        # Verify allowed time windows
        #if ("%{sql:SELECT COUNT(*) FROM time_restrictions WHERE username = '%{User-Name}' AND CURRENT_TIME() NOT BETWEEN start_time AND end_time}" > 0) {
        #    reject
        #}

        # Add session controls to the response
        update reply {

            # Session timeout (in seconds) (let keep it dynamic based on midnight)
            #Session-Timeout := "%{sql:SELECT session_timeout FROM radprofile p JOIN raduserprofile up ON p.id = up.profile_id WHERE up.username = '%{User-Name}'}"
            
            # Idle timeout (in seconds)
            Idle-Timeout := "%{sql:SELECT idle_timeout FROM radprofile p JOIN raduserprofile up ON p.id = up.profile_id WHERE up.username = '%{User-Name}'}"
            
            # Maximum number of concurrent sessions
            Port-Limit := "%{sql:SELECT max_sessions FROM radprofile p JOIN raduserprofile up ON p.id = up.profile_id WHERE up.username = '%{User-Name}'}"
        }

        # Check for concurrent sessions (ignore stale sessions).
        # A session is considered "active" only if it has an update within the last 10 minutes.
        # IMPORTANT: use >= so max_sessions=1 blocks a 2nd active session.
        if ("%{sql:SELECT COUNT(*) FROM radacct WHERE username = '%{User-Name}' AND acctstoptime IS NULL AND COALESCE(acctupdatetime, acctstarttime) >= DATE_SUB(NOW(), INTERVAL 10 MINUTE)}" >= "%{sql:SELECT max_sessions FROM radprofile p JOIN raduserprofile up ON p.id = up.profile_id WHERE up.username = '%{User-Name}'}") {
            update reply {
                Reply-Message := "Too many concurrent sessions"
            }
            reject
        }
    }

    authenticate {
        Auth-Type PAP {
            pap
        }
        Auth-Type CHAP {
            chap
        }
        Auth-Type MS-CHAP {
            mschap
        }
    }
    
    post-auth {
        # Log successful authentication
        # Production note:
        # Disable noisy debug exec modules by default. Use FREERADIUS_DEBUG=1 (-X) for verbose logs.
        #test_echo
        #my_debug_log
        # Track auth success (status enum is accepted/rejected/attempt/...)
        "%{sql:insert into connection_logs (username, mac_address, nas_ip, status, acct_status, terminate_cause, reply_message, timestamp) \
          values ('%{User-Name}', '%{Calling-Station-Id}', '%{NAS-IP-Address}', 'accepted', NULL, NULL, '%{%{reply:Reply-Message}:-}', NOW());}"

        # Reply logging (Access-Accept)
        if ("$ENV{RADIUS_REQUEST_LOG_ENABLED}" == "1") {
            radius_reply_log
        }
        
        
        # Bind MAC if needed
        if ("%{sql:SELECT COALESCE(COUNT(*), 0) FROM user_mac WHERE username = '%{User-Name}' AND mac_address = '%{Calling-Station-Id}'}" == 0) {
            bind_mac
        }
       
        update reply {
            Reply-Message := "Authentication successful for %{User-Name}"
             Session-Timeout := "%{exec:/opt/freeradius/3.0/scripts/calculate_timeout.sh}"
        }

        ok

        Post-Auth-Type REJECT {
            # Track auth failure (avoid exec script mismatch / schema drift)
            # If we rate-limited the request, don't insert "rejected" again or the lockout becomes self-sustaining.
            if (!&Tmp-Integer-7) {
                "%{sql:insert into connection_logs (username, mac_address, nas_ip, status, acct_status, terminate_cause, reply_message, timestamp) \
                  values ('%{User-Name}', '%{Calling-Station-Id}', '%{NAS-IP-Address}', 'rejected', NULL, NULL, \
                          '%{%{control:Module-Failure-Message}:-%{%{reply:Reply-Message}:-}}', NOW());}"
            }
            # Apply standard reject attribute filtering after we logged the reason.
            attr_filter.access_reject

            # Reply logging (Access-Reject)
            if ("$ENV{RADIUS_REQUEST_LOG_ENABLED}" == "1") {
                radius_reply_log
            }
        }
    }

    preacct {
        preprocess
    }

    accounting {
        # NOTE (production):
        # `detail` writes files under ${logdir}/radacct/<NAS-IP>/detail-YYYYMMDD.
        # On Windows bind-mounts (./logs:/var/log/freeradius) this often becomes non-writable
        # for the `freerad` user, causing "Failed to create directory ... Permission denied"
        # and disrupting user sessions. We already persist accounting in MySQL below, so
        # disable `detail` file writing.
        #detail
        sql
        exec

        # Accounting logging (Interim-Update/Start/Stop)
        if ("$ENV{RADIUS_REQUEST_LOG_ENABLED}" == "1") {
            radius_accounting_log
        }

        update control {
            Free-Night := "0"  # Default value if not set
        }

        update control {
            Packet-Src-IP-Address := "%{Packet-Src-IP-Address}"
        }


        # Check for free night usage
        if ("%{sql:SELECT (CURRENT_TIME BETWEEN night_start AND night_end) AS is_night_mode \
            FROM settings \
            WHERE key_attribute = 'Free-Night' \
            AND if_enabled = '1'}" == 1) {
           update control {
               Free-Night := "1"
           }
        }

        if (&control:Free-Night != "1") {
            # Avoid leaking debug messages to NAS / clients in production.
            #update reply {
            #    Reply-Message := "Debug: Free-Night is not active"
            #}
        }

        # acct_status column is ENUM('start','stop','update') in your schema.
        "%{sql:insert into connection_logs (username, mac_address, nas_ip, status, acct_status, terminate_cause, timestamp) \
        values ('%{User-Name}', '%{Calling-Station-Id}', '%{NAS-IP-Address}', 'accepted', \
                CASE '%{Acct-Status-Type}' WHEN 'Start' THEN 'start' WHEN 'Stop' THEN 'stop' ELSE 'update' END, \
                NULL, NOW());}"

        # Track session states
        if (Acct-Status-Type == Start) {
            update request {
                SQL-User-Name := "%{User-Name}"
                SQL-Acct-Session-Id := "%{Acct-Session-Id}"
                Event-Timestamp := "%{expr: %l}"
            }
            
            # Initialize counters on Start so the first Interim-Update doesn't over-count.
            "%{sql: INSERT INTO session_tracking \
                (session_id, username, mac_address, start_time, last_update, status, nas_ip, framed_ip, bytes_in, bytes_out, session_time) \
                VALUES ( \
                  '%{Acct-Session-Id}', '%{SQL-User-Name}', '%{Calling-Station-Id}', NOW(), NOW(), 'active', \
                  '%{NAS-IP-Address}', '%{Framed-IP-Address}', \
                  ((%{%{Acct-Input-Gigawords}:-0} * 4294967296) + %{%{Acct-Input-Octets}:-0}), \
                  ((%{%{Acct-Output-Gigawords}:-0} * 4294967296) + %{%{Acct-Output-Octets}:-0}), \
                  %{%{Acct-Session-Time}:-0} \
                )}"

            "%{sql:INSERT INTO radusagestats (username, day, data_usage) \
               VALUES ('%{User-Name}', CURDATE(),0) \
                ON DUPLICATE KEY UPDATE data_usage = data_usage}"

            #
            # Populate radacct (source of truth for "online" sessions).
            # We do this explicitly because the current SQL module config is used mostly
            # for xlat expansions, and may not automatically write radacct records.
            #
            "%{sql:INSERT IGNORE INTO radacct (acctsessionid, acctuniqueid, username, nasipaddress, \
                    acctstarttime, acctupdatetime, acctstoptime, acctinterval, acctsessiontime, \
                    acctinputoctets, acctoutputoctets, calledstationid, callingstationid, framedipaddress) \
                  VALUES ( \
                    '%{Acct-Session-Id}', \
                    MD5(CONCAT('%{Acct-Session-Id}','|','%{User-Name}','|','%{NAS-IP-Address}')), \
                    '%{User-Name}', \
                    '%{NAS-IP-Address}', \
                    NOW(), NOW(), NULL, \
                    0, \
                    COALESCE(NULLIF('%{Acct-Session-Time}', ''), 0), \
                    COALESCE(NULLIF('%{Acct-Input-Octets}', ''), 0), \
                    COALESCE(NULLIF('%{Acct-Output-Octets}', ''), 0), \
                    '%{Called-Station-Id}', \
                    '%{Calling-Station-Id}', \
                    '%{Framed-IP-Address}' \
                  )}"

            #"%{sql: INSERT INTO radusagestats (username, day, data_usage, last_input, last_output, session_start_input, session_start_output) \
            #    VALUES ('%{User-Name}', CURDATE(), 0, COALESCE(NULLIF('%{Acct-Input-Octets}', ''), '0'), COALESCE(NULLIF('%{Acct-Output-Octets}', ''), '0'), \
            #            COALESCE(NULLIF('%{Acct-Input-Octets}', ''), '0'), COALESCE(NULLIF('%{Acct-Output-Octets}', ''), '0')) \
            #    ON DUPLICATE KEY UPDATE \
            #        last_input = COALESCE(NULLIF('%{Acct-Input-Octets}', ''), '0'),\
            #        last_output = COALESCE(NULLIF('%{Acct-Output-Octets}', ''), '0'), \
            #        session_start_input = COALESCE(NULLIF('%{Acct-Input-Octets}', ''), '0'), \
            #        session_start_output = COALESCE(NULLIF('%{Acct-Output-Octets}', ''), '0')}"



            sql
            ok
        }
        elsif (Acct-Status-Type == Stop) {

                # Ensure today's row exists
                "%{sql:INSERT INTO radusagestats (username, day, data_usage) \
                      VALUES ('%{User-Name}', CURDATE(), 0) \
                      ON DUPLICATE KEY UPDATE data_usage = data_usage}"

                # Increment daily usage by delta since last update (handles sessions spanning midnight).
                # Uses Gigawords to avoid 32-bit counter wrap.
                if (&control:Free-Night != "1") {
                    "%{sql:UPDATE radusagestats r \
                          JOIN session_tracking st \
                            ON st.username = r.username \
                           AND st.session_id = '%{Acct-Session-Id}' \
                          SET r.data_usage = r.data_usage \
                              + GREATEST(((%{%{Acct-Input-Gigawords}:-0} * 4294967296) + %{%{Acct-Input-Octets}:-0}) - st.bytes_in, 0) \
                              + GREATEST(((%{%{Acct-Output-Gigawords}:-0} * 4294967296) + %{%{Acct-Output-Octets}:-0}) - st.bytes_out, 0) \
                          WHERE r.username = '%{User-Name}' \
                            AND r.day = CURDATE()}"
                }

                # Persist latest counters + close session
                "%{sql: UPDATE session_tracking \
                       SET end_time = NOW(), \
                           last_update = NOW(), \
                           status = 'completed', \
                           bytes_in = ((%{%{Acct-Input-Gigawords}:-0} * 4294967296) + %{%{Acct-Input-Octets}:-0}), \
                           bytes_out = ((%{%{Acct-Output-Gigawords}:-0} * 4294967296) + %{%{Acct-Output-Octets}:-0}), \
                           session_time = %{%{Acct-Session-Time}:-0} \
                     WHERE session_id = '%{Acct-Session-Id}' \
                       AND username = '%{User-Name}'}"

                #
                # Real-time quota enforcement on Stop as well (sessions may end before next Interim-Update).
                # Update DB flags/profile so the next auth and admin UI reflect the correct state.
                #
                #
                # IMPORTANT:
                # Always compare usage against the user's *default/original* profile quotas,
                # not the current `raduserprofile.profile_id` (which may already be "Fallback").
                #
                update request {
                    Tmp-Integer-0 := "%{sql:SELECT \
                                        IF(COALESCE(SUM(data_usage), 0) >= \
                                            (SELECT COALESCE(dp.monthly_quota, cp.monthly_quota) \
                                               FROM raduserprofile up \
                                               JOIN radprofile cp ON cp.id = up.profile_id \
                                          LEFT JOIN user_default_profiles udp ON udp.username = up.username \
                                          LEFT JOIN radprofile dp ON dp.id = udp.default_profile_id \
                                              WHERE up.username = '%{User-Name}' \
                                              LIMIT 1), 1, 0) \
                                        FROM radusagestats \
                                        WHERE username = '%{User-Name}' \
                                        AND day >= DATE_FORMAT(NOW(), CONCAT('%Y-%m-',LPAD((SELECT up.quota_reset_day FROM raduserprofile up WHERE up.username = '%{User-Name}'), 2, '0'))) }"
                }

                update request {
                    Tmp-Integer-1 := "%{sql:SELECT \
                                        IF(COALESCE(SUM(data_usage), 0) >= \
                                            (SELECT COALESCE(dp.daily_quota, cp.daily_quota) \
                                               FROM raduserprofile up \
                                               JOIN radprofile cp ON cp.id = up.profile_id \
                                          LEFT JOIN user_default_profiles udp ON udp.username = up.username \
                                          LEFT JOIN radprofile dp ON dp.id = udp.default_profile_id \
                                              WHERE up.username = '%{User-Name}' \
                                              LIMIT 1), 1, 0) \
                                        FROM radusagestats \
                                        WHERE username = '%{User-Name}' \
                                        AND day = CURDATE() }"
                }

                if (Tmp-Integer-0 == "1") {
                    quota_monthly_exceeded_proc
                }
                elsif (Tmp-Integer-1 == "1") {
                    quota_daily_exceeded_proc
                }

                # Close radacct row
                # (If start packet was missed, create the row before closing it.)
                "%{sql:INSERT INTO radacct (acctsessionid, acctuniqueid, username, nasipaddress, \
                        acctstarttime, acctupdatetime, acctstoptime, acctinterval, acctsessiontime, \
                        acctinputoctets, acctoutputoctets, calledstationid, callingstationid, framedipaddress) \
                      SELECT \
                        '%{Acct-Session-Id}', \
                        MD5(CONCAT('%{Acct-Session-Id}','|','%{User-Name}','|','%{NAS-IP-Address}')), \
                        '%{User-Name}', \
                        '%{NAS-IP-Address}', \
                        NOW(), NOW(), NULL, \
                        0, \
                        COALESCE(NULLIF('%{Acct-Session-Time}', ''), 0), \
                        COALESCE(NULLIF('%{Acct-Input-Octets}', ''), 0), \
                        COALESCE(NULLIF('%{Acct-Output-Octets}', ''), 0), \
                        '%{Called-Station-Id}', \
                        '%{Calling-Station-Id}', \
                        '%{Framed-IP-Address}' \
                      WHERE NOT EXISTS ( \
                        SELECT 1 FROM radacct \
                        WHERE acctsessionid = '%{Acct-Session-Id}' \
                          AND username = '%{User-Name}' \
                          AND nasipaddress = '%{NAS-IP-Address}' \
                          AND acctstoptime IS NULL \
                      )}"
                "%{sql:UPDATE radacct SET \
                        acctstoptime = NOW(), \
                        acctupdatetime = NOW(), \
                        acctinterval = 0, \
                        acctsessiontime = COALESCE(NULLIF('%{Acct-Session-Time}', ''), 0), \
                        acctinputoctets = COALESCE(NULLIF('%{Acct-Input-Octets}', ''), 0), \
                        acctoutputoctets = COALESCE(NULLIF('%{Acct-Output-Octets}', ''), 0), \
                        calledstationid = '%{Called-Station-Id}', \
                        callingstationid = '%{Calling-Station-Id}', \
                        framedipaddress = '%{Framed-IP-Address}', \
                        acctterminatecause = '%{Acct-Terminate-Cause}' \
                      WHERE acctsessionid = '%{Acct-Session-Id}' \
                        AND username = '%{User-Name}' \
                        AND nasipaddress = '%{NAS-IP-Address}' \
                        AND acctstoptime IS NULL}"

                track_usage
                sql
        }
        elsif (Acct-Status-Type == Interim-Update) {

            update request {
                Acct-Status-Type      := "Alive"
                SQL-User-Name         := "%{User-Name}"
                SQL-Acct-Session-Id   := "%{Acct-Session-Id}"
            }

            # Ensure today's row exists
            "%{sql:INSERT INTO radusagestats (username, day, data_usage) \
                  VALUES ('%{User-Name}', CURDATE(), 0) \
                  ON DUPLICATE KEY UPDATE data_usage = data_usage}"

            # Increment daily usage by delta since last update (handles sessions spanning midnight).
            # Uses Gigawords to avoid 32-bit counter wrap.
            if (&control:Free-Night != "1") {
                "%{sql:UPDATE radusagestats r \
                      JOIN session_tracking st \
                        ON st.username = r.username \
                       AND st.session_id = '%{Acct-Session-Id}' \
                      SET r.data_usage = r.data_usage \
                          + GREATEST(((%{%{Acct-Input-Gigawords}:-0} * 4294967296) + %{%{Acct-Input-Octets}:-0}) - st.bytes_in, 0) \
                          + GREATEST(((%{%{Acct-Output-Gigawords}:-0} * 4294967296) + %{%{Acct-Output-Octets}:-0}) - st.bytes_out, 0) \
                      WHERE r.username = '%{User-Name}' \
                        AND r.day = CURDATE()}"
            }

            # Persist latest counters
            "%{sql: UPDATE session_tracking \
                   SET last_update = NOW(), \
                       bytes_in = ((%{%{Acct-Input-Gigawords}:-0} * 4294967296) + %{%{Acct-Input-Octets}:-0}), \
                       bytes_out = ((%{%{Acct-Output-Gigawords}:-0} * 4294967296) + %{%{Acct-Output-Octets}:-0}), \
                       session_time = %{%{Acct-Session-Time}:-0} \
                 WHERE session_id = '%{Acct-Session-Id}' \
                   AND status = 'active' \
                   AND username = '%{User-Name}'}"

            # Update radacct row
            # (If start packet was missed, create the row here.)
            "%{sql:INSERT INTO radacct (acctsessionid, acctuniqueid, username, nasipaddress, \
                    acctstarttime, acctupdatetime, acctstoptime, acctinterval, acctsessiontime, \
                    acctinputoctets, acctoutputoctets, calledstationid, callingstationid, framedipaddress) \
                  SELECT \
                    '%{Acct-Session-Id}', \
                    MD5(CONCAT('%{Acct-Session-Id}','|','%{User-Name}','|','%{NAS-IP-Address}')), \
                    '%{User-Name}', \
                    '%{NAS-IP-Address}', \
                    NOW(), NOW(), NULL, \
                    0, \
                    COALESCE(NULLIF('%{Acct-Session-Time}', ''), 0), \
                    COALESCE(NULLIF('%{Acct-Input-Octets}', ''), 0), \
                    COALESCE(NULLIF('%{Acct-Output-Octets}', ''), 0), \
                    '%{Called-Station-Id}', \
                    '%{Calling-Station-Id}', \
                    '%{Framed-IP-Address}' \
                  WHERE NOT EXISTS ( \
                    SELECT 1 FROM radacct \
                    WHERE acctsessionid = '%{Acct-Session-Id}' \
                      AND username = '%{User-Name}' \
                      AND nasipaddress = '%{NAS-IP-Address}' \
                      AND acctstoptime IS NULL \
                  )}"
            "%{sql:UPDATE radacct SET \
                    acctupdatetime = NOW(), \
                    acctinterval = 0, \
                    acctsessiontime = COALESCE(NULLIF('%{Acct-Session-Time}', ''), 0), \
                    acctinputoctets = COALESCE(NULLIF('%{Acct-Input-Octets}', ''), 0), \
                    acctoutputoctets = COALESCE(NULLIF('%{Acct-Output-Octets}', ''), 0), \
                    calledstationid = '%{Called-Station-Id}', \
                    callingstationid = '%{Calling-Station-Id}', \
                    framedipaddress = '%{Framed-IP-Address}' \
                  WHERE acctsessionid = '%{Acct-Session-Id}' \
                    AND username = '%{User-Name}' \
                    AND nasipaddress = '%{NAS-IP-Address}' \
                    AND acctstoptime IS NULL}"

            sql


            # Check if user has exceeded their monthly quota (compare against default/original plan quota).
            update request {
                Tmp-Integer-0 := "%{sql:SELECT \
                                    IF(COALESCE(SUM(data_usage), 0) >= \
                                        (SELECT COALESCE(dp.monthly_quota, cp.monthly_quota) \
                                           FROM raduserprofile up \
                                           JOIN radprofile cp ON cp.id = up.profile_id \
                                      LEFT JOIN user_default_profiles udp ON BINARY udp.username = BINARY up.username \
                                      LEFT JOIN radprofile dp ON dp.id = udp.default_profile_id \
                                          WHERE up.username = '%{User-Name}' \
                                          LIMIT 1), 1, 0) \
                                    FROM radusagestats \
                                    WHERE username = '%{User-Name}' \
                                    AND day >= DATE_FORMAT(NOW(), CONCAT('%Y-%m-',LPAD((SELECT up.quota_reset_day FROM raduserprofile up WHERE up.username = '%{User-Name}'), 2, '0'))) }"
            }

            # Check if user has exceeded their daily quota (compare against default/original plan quota).
            update request {
                Tmp-Integer-1 := "%{sql:SELECT \
                                    IF(COALESCE(SUM(data_usage), 0) >= \
                                        (SELECT COALESCE(dp.daily_quota, cp.daily_quota) \
                                           FROM raduserprofile up \
                                           JOIN radprofile cp ON cp.id = up.profile_id \
                                      LEFT JOIN user_default_profiles udp ON BINARY udp.username = BINARY up.username \
                                      LEFT JOIN radprofile dp ON dp.id = udp.default_profile_id \
                                          WHERE up.username = '%{User-Name}' \
                                          LIMIT 1), 1, 0) \
                                    FROM radusagestats \
                                    WHERE username = '%{User-Name}' \
                                    AND day = CURDATE() }"
            }

            # Is the user already marked as fallback? (avoid re-sending CoA on every Interim-Update)
            update request {
                Tmp-Integer-2 := "%{sql:SELECT IF(COALESCE(is_fallback,0)=1 OR COALESCE(is_monthly_exceeded,0)=1, 1, 0) \
                                    FROM raduserprofile \
                                    WHERE username = '%{User-Name}' \
                                    LIMIT 1}"
            }

            # Debug message to check the value of Tmp-Integer-0
            #if ("%{Tmp-Integer-0}") {
            #  update reply {
            #       Reply-Message := "Debug: Tmp-Integer-0 = %{Tmp-Integer-0}"
            #   }
             # }

            # if ("%{Tmp-Integer-1}") {
                #    update reply {
                    #  Reply-Message := "Debug: Tmp-Integer-1 = %{Tmp-Integer-1}"
                #    }
            #}

            # Apply rate limit if user exceeded quota
            if (Tmp-Integer-0 == "1" || Tmp-Integer-1 == "1") {
                update reply {
                    # MikroTik format is "download/upload" in kbit/s (e.g., 1024k/512k)
                    Mikrotik-Rate-Limit := "%{sql:SELECT CONCAT(speed_down, 'k/', speed_up, 'k') \
                                            FROM radprofile \
                                            WHERE profile_name = 'Fallback'}"
                }
                # Mark fallback (DB) + send CoA once, so the active session immediately switches to fallback rate.
                if (Tmp-Integer-2 == "0") {
                    if (Tmp-Integer-0 == "1") {
                        quota_monthly_exceeded_proc
                    }
                    elsif (Tmp-Integer-1 == "1") {
                        quota_daily_exceeded_proc
                    }
                    coa_rate_limit
                }
            }
        }

    }

    session {
        sql
    }

    pre-proxy {
    }

    post-proxy {
        Post-Proxy-Type Fail {
            attr_filter.post-proxy
        }
    }
}