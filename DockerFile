# Pin base OS for reproducible builds (update digest when patching Ubuntu).
FROM ubuntu:22.04@sha256:ce941a2a18bbb922e434d6d6d2b31e571a5c3826eaf6ada0a41dcc905bd2d906

ARG IMAGE_VERSION=5.0.0
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="Radius Pro FreeRADIUS" \
      org.opencontainers.image.description="FreeRADIUS 3.x for ISP quota, CoA, expiry, and MAC binding" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="https://github.com/xnetcloud/radius-docker-image" \
      org.opencontainers.image.vendor="XNet Cloud"

# Install runtime dependencies (keep image minimal for production)
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    freeradius \
    freeradius-mysql \
    freeradius-utils \
    mysql-client \
    procps \
    iproute2 \
    tzdata \
    grep \
    && rm -rf /var/lib/apt/lists/*

# Ensure freerad user exists first
RUN adduser --system --no-create-home --group freerad || true

# Create necessary directories
RUN mkdir -p /etc/freeradius/3.0/mods-enabled \
    /etc/freeradius/3.0/mods-available \
    /etc/freeradius/3.0/sites-enabled \
    /etc/freeradius/3.0/sites-available

# Copy configuration files first
COPY raddb/ /etc/freeradius/3.0/

# Copy custom dictionaries
COPY raddb/dictionary.dailyquota /etc/freeradius/3.0/dictionary.dailyquota
COPY raddb/dictionary.custom /etc/freeradius/3.0/dictionary.custom
COPY raddb/scripts /opt/freeradius/3.0/scripts
# Normalize Windows CRLF line endings (otherwise scripts fail with "/bin/bash^M: not found").
RUN for f in /opt/freeradius/3.0/scripts/*.sh; do \
      [ -f "$f" ] || continue; \
      tr -d '\r' < "$f" > "${f}.tmp" && mv "${f}.tmp" "$f"; \
    done || true
RUN chmod +x /opt/freeradius/3.0/scripts/*.sh || true

# Add includes to main dictionary
RUN echo '$INCLUDE /etc/freeradius/3.0/dictionary.dailyquota' >> /etc/freeradius/3.0/dictionary && \
    echo '$INCLUDE /etc/freeradius/3.0/dictionary.custom' >> /etc/freeradius/3.0/dictionary

# Symbolic links for enabled modules
RUN ln -sf /etc/freeradius/3.0/mods-available/sql /etc/freeradius/3.0/mods-enabled/sql && \
    ln -sf /etc/freeradius/3.0/mods-config/sql/counter/daily_quota.conf /etc/freeradius/3.0/mods-enabled/dailyquota && \
    ln -sf /etc/freeradius/3.0/mods-available/pap /etc/freeradius/3.0/mods-enabled/pap && \
    ln -sf /etc/freeradius/3.0/mods-available/chap /etc/freeradius/3.0/mods-enabled/chap && \
    ln -sf /etc/freeradius/3.0/mods-available/mschap /etc/freeradius/3.0/mods-enabled/mschap && \
    ln -sf /etc/freeradius/3.0/mods-available/exec /etc/freeradius/3.0/mods-enabled/exec && \
    ln -sf /etc/freeradius/3.0/mods-available/linelog /etc/freeradius/3.0/mods-enabled/linelog

# Copy startup script
COPY start.sh /start.sh
RUN chmod +x /start.sh

# Set proper permissions
RUN mkdir -p /var/log/freeradius && \
    chown -R freerad:freerad /var/log/freeradius && \
    chown -R freerad:freerad /etc/freeradius/3.0 && \
    chmod -R u=rwX,g=rX,o= /etc/freeradius/3.0 && \
    find /etc/freeradius/3.0 -type d -exec chmod 750 {} \; && \
    find /etc/freeradius/3.0 -type f -exec chmod 640 {} \; && \
    chmod 640 /etc/freeradius/3.0/clients.conf && \
    chmod -R 640 /etc/freeradius/3.0/certs/* && \
    chmod 750 /etc/freeradius/3.0/mods-enabled && \
    chmod 750 /etc/freeradius/3.0/sites-enabled && \
    chmod 644 /etc/freeradius/3.0/mods-config/sql/main/mysql/queries.conf && \
    chown freerad:freerad /etc/freeradius/3.0/mods-config/sql/main/mysql/queries.conf

RUN mkdir -p /var/log/freeradius/radacct && \
    chown -R freerad:freerad /var/log/freeradius/radacct

RUN mkdir -p /etc/freeradius/3.0/certs && \
    chown -R freerad:freerad /etc/freeradius/3.0/certs

EXPOSE 1812/udp 1813/udp 1700/udp

# start.sh owns process lifecycle (MySQL wait, bootstrap, freeradius -f or -X).
ENTRYPOINT ["/start.sh"]
