## FreeRADIUS docker image env (defaults preserved)
## Copy to `.env` if you want to override defaults.
##
## Windows (PowerShell):
##   Copy-Item env.example .env

# Timezone (affects DAILY_RESET_AT scheduling)
TZ=UTC

# MySQL connection (matches your current defaults)
SQL_SERVER=172.8.16.4
SQL_USER=radius
SQL_PASSWORD=password
SQL_PORT=3306
SQL_DATABASE=radius

# FreeRADIUS
FREERADIUS_DEBUG=0

# Daily reset job inside container
DAILY_RESET_ENABLED=1
DAILY_RESET_AT=00:01

