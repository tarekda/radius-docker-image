## FreeRADIUS docker image env (PRODUCTION TEMPLATE)
## Copy to `.env` and fill required values.
##
## Windows (PowerShell):
##   Copy-Item env.example .env
#
## Docker Compose (read by the `docker compose` CLI from this file when you run it in this directory):
# On some Windows + Docker Desktop setups, Compose "Bake" fails to find Dockerfile during build.
# This disables Bake so normal `docker compose build` / `up --build` work. Safe to keep on Linux too.
COMPOSE_BAKE=false
## Then from this directory you can run:
##   docker compose build
##   docker compose up -d
## If build still errors (Windows), in that PowerShell session run once:  $env:COMPOSE_BAKE='false'

# Timezone (affects DAILY_RESET_AT scheduling)
TZ=UTC

# MySQL connection (REQUIRED)
SQL_SERVER=172.8.16.4
SQL_USER=radius
# Prefer secrets:
#   SQL_PASSWORD_FILE=/run/secrets/sql_password
# Otherwise set SQL_PASSWORD in your environment (do NOT commit it).
SQL_PASSWORD=
SQL_PASSWORD_FILE=
SQL_PORT=3306
SQL_DATABASE=radius

# FreeRADIUS
FREERADIUS_DEBUG=0
RADIUS_REQUEST_LOG_ENABLED=0

# Daily reset job inside container
DAILY_RESET_ENABLED=1
DAILY_RESET_AT=00:01

# Loopback Status-Server probe (change in production)
HEALTHCHECK_SECRET=radius-healthcheck
