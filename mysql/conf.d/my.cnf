[mysqld]
# Allow the radius user (non-SUPER) to create fn_quota_cycle_start / procedures
# when binary logging is enabled (bootstrap_schema.sh applies them on container start).
log_bin_trust_function_creators = 1

wait_timeout = 600
interactive_timeout = 600
max_connections = 1000
connect_timeout = 60
net_read_timeout = 60
net_write_timeout = 60

[client]
default-character-set = utf8mb4 